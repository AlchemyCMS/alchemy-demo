<% cache(concept_grid) do %>
<%= element_view_for(concept_grid) do |el| %>
  <section id="concepts" class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-center font-display text-3xl font-bold text-ink"><%= el.render :headline %></h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <%= render concept_grid.nested_elements %>
    </div>
    <%= render "shared/reveal", element: concept_grid %>
  </section>
<% end %>
<% end %>
