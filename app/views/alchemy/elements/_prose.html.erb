<% cache(prose) do %>
<%= element_view_for(prose, class: "group") do |el| %>
  <section class="mx-auto max-w-3xl px-4">
    <%= el.render :headline, {}, { class: "font-display font-bold text-ink" } %>
    <div class="prose-content mt-3 text-ink-soft"><%= el.render :text %></div>
    <%= render "shared/reveal", element: prose %>
  </section>
<% end %>
<% end %>
