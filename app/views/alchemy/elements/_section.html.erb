<% cache(section) do %>
<%= element_view_for(section, tag: :section, class: "group #{section.value_for(:background)} #{section.value_for(:spacing)}") do |el| %>
  <div class="mx-auto max-w-5xl space-y-10 px-4">
    <%= render el.nested_elements %>
    <%= render "shared/reveal", element: section %>
  </div>
<% end %>
<% end %>
