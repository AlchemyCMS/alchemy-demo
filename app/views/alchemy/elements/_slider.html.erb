<% cache(slider) do %>
  <% if slider.nested_elements.any? %>
    <%= element_view_for(slider, class: 'row') do |el| -%>
      <div class="large-12 columns">
        <ul data-orbit data-options="bullets: false; timer: false; slide_number: false">
          <%= render el.nested_elements %>
        </ul>
        <hr>
      </div>
    <% end %>
  <% end %>
<% end %>
