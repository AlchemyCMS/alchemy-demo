<% cache(hero) do %>
<%= element_view_for(hero) do |el| %>
  <section class="bg-surface">
    <div class="mx-auto max-w-5xl px-4 py-24 text-center">
      <%= el.render :headline, {}, { class: "font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl" } %>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-soft"><%= el.render :subheadline %></p>
      <%= el.render :cta, {}, { class: "mt-8 inline-block rounded-lg bg-accent px-6 py-3 font-medium text-white transition-colors hover:bg-accent-dark" } %>
    </div>
  </section>
  <div class="mx-auto max-w-5xl px-4"><%= render "shared/reveal", element: hero %></div>
<% end %>
<% end %>
