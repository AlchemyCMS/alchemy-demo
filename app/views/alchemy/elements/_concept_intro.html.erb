<% cache(concept_intro) do %>
<%= element_view_for(concept_intro, class: "group") do |el| %>
  <section class="mx-auto max-w-3xl px-4 text-center">
    <% if concept_intro.value_for(:eyebrow).present? %>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent"><%= el.render :eyebrow %></p>
    <% end %>
    <%= el.render :headline, {}, { class: "font-display font-bold text-ink" } %>
    <div class="prose-content mt-4 text-lg text-ink-soft"><%= el.render :lead %></div>
    <%= render "shared/reveal", element: concept_intro %>
  </section>
<% end %>
<% end %>
