<% cache(post_header) do %>
<%= element_view_for(post_header, class: "group") do |el| %>
  <header class="mx-auto max-w-3xl px-4">
    <%= el.render :headline, {}, { class: "font-display font-bold text-ink" } %>
    <p class="mt-2 text-sm text-ink-soft">
      <% if post_header.value_for(:published_at) %><%= post_header.value_for(:published_at).strftime("%B %-d, %Y") %><% end %>
      <% if post_header.value_for(:author).present? %>· <%= el.render :author %><% end %>
    </p>
  </header>
  <% if post_header.value_for(:image).present? %>
    <div class="mx-auto mt-6 max-w-4xl px-4">
      <%= el.render :image, {}, { class: "aspect-video w-full rounded-2xl object-cover" } %>
    </div>
  <% end %>
  <div class="prose-content mx-auto mt-6 max-w-3xl px-4 text-lg text-ink-soft"><%= el.render :intro %></div>
  <div class="mx-auto max-w-3xl px-4"><%= render "shared/reveal", element: post_header %></div>
<% end %>
<% end %>
