<article class="rounded-xl border border-accent-soft/40 bg-white p-5 shadow-sm">
  <p class="text-xs font-semibold uppercase tracking-wide text-accent"><%= event.date_range %></p>
  <h3 class="mt-1 font-display text-lg font-bold text-ink"><%= event.name %></h3>
  <% if event.location %>
    <p class="mt-1 text-sm text-ink-soft">📍 <%= event.location.name %></p>
  <% end %>
  <% if event.description.present? %>
    <p class="mt-3 text-sm/relaxed text-ink-soft"><%= event.description %></p>
  <% end %>
</article>
