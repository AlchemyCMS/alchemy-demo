<li>
  <%= link_to_if node.url,
    node.name,
    @preview_mode ? 'javascript: void(0)' : node.url,
    class: [
      'block rounded-md px-3 py-2 text-sm font-medium transition-colors',
      current_page?(node.url) ? 'bg-accent/10 text-accent' : 'text-ink-soft hover:bg-accent/10 hover:text-accent'
    ].compact.join(' '),
    target: node.external? ? '_blank' : nil,
    rel: node.nofollow? ? 'nofollow' : nil %>
  <% if node.children.any? %>
    <ul class="ml-4 mt-1 flex flex-col gap-1 border-l border-accent-soft/30 pl-2">
      <%= render partial: 'alchemy/menus/main_navigation/node',
        collection: node.children.includes(:page, :children), as: 'node' %>
    </ul>
  <% end %>
</li>
