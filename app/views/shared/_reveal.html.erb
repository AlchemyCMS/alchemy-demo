<% yaml = element_definition_yaml(element) %>
<details class="group mt-6 rounded-lg border border-accent-soft/50 bg-surface-violet/40 text-left">
  <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-2 text-sm font-medium text-accent-dark">
    <span class="text-accent">🔍</span>
    How this block is built
    <span class="ml-auto text-xs text-ink-soft group-open:hidden">show</span>
    <span class="ml-auto hidden text-xs text-ink-soft group-open:inline">hide</span>
  </summary>
  <div class="border-t border-accent-soft/50 px-4 py-3">
    <p class="mb-2 text-xs text-ink-soft">Defined in <code class="text-accent">config/alchemy/elements.yml</code>:</p>
    <% if yaml %>
      <pre class="overflow-x-auto rounded-md bg-ink px-4 py-3 text-xs/relaxed text-surface-grey"><code><%= yaml %></code></pre>
    <% end %>
  </div>
</details>
