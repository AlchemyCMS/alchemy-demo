<% source = element_definition_yaml(element) %>
<% dialog_id = "reveal-#{element.id}" %>
<p class="mt-4 text-left">
  <button type="button" command="show-modal" commandfor="<%= dialog_id %>"
    class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-soft/80 transition-colors hover:text-accent">
    <span aria-hidden="true">🔍</span> How this block is built
  </button>
</p>

<dialog id="<%= dialog_id %>" class="m-auto w-[min(42rem,92vw)] rounded-xl p-0 shadow-xl backdrop:bg-ink/50">
  <div class="flex items-center justify-between gap-4 border-b border-accent-soft/40 bg-surface-violet px-4 py-3">
    <span class="font-mono text-xs text-accent-dark">config/alchemy/elements.yml</span>
    <button type="button" command="close" commandfor="<%= dialog_id %>"
      class="rounded px-2 text-lg/none text-ink-soft transition-colors hover:bg-white hover:text-ink" aria-label="Close">&times;</button>
  </div>
  <% if source %>
    <pre class="max-h-[70vh] overflow-auto bg-ink px-4 py-4 text-left text-xs/relaxed text-surface-grey"><code><%= source %></code></pre>
  <% end %>
</dialog>
