<%# Geometric icons drawn in the same hand-authored style as the concept
    illustrations in db/seeds/images, so the demo needs no icon dependency.
    Keys must match the `icon` Select values on the feature_item element. %>
<% shapes = {
  "photo" => '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="M3 17l6-5 4 3 3-2 5 4"/>',
  "documents" => '<rect x="8" y="3" width="13" height="15" rx="2"/><path d="M16 21H5a2 2 0 0 1-2-2V8"/>',
  "clock" => '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  "lock" => '<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  "magnifier" => '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.2 15.2L21 21"/>',
  "globe" => '<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>',
  "menu" => '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  "code" => '<path d="M9 7l-5 5 5 5"/><path d="M15 7l5 5-5 5"/>'
} %>
<% if (shape = shapes[name]) %>
  <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-surface-violet text-accent">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= raw shape %></svg>
  </span>
<% end %>
