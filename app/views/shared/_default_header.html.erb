        <path transform="translate(8 1.73) translate(17.04 -14.31) scale(0.6417) rotate(-10)" d="M 21.56 17.55 Q 13.69 23.71, 4.42 27.45 Q 0 30, -4.42 27.45 Q -13.69 23.71, -21.56 17.55 Q -25.98 15, -25.98 9.9 Q -27.38 0, -25.98 -9.9 Q -25.98 -15, -21.56 -17.55 Q -13.69 -23.71, -4.42 -27.45 Q 0 -30, 4.42 -27.45 Q 13.69 -23.71, 21.56 -17.55 Q 25.98 -15, 25.98 -9.9 Q 27.38 0, 25.98 9.9 Q 25.98 15, 21.56 17.55 Z"></path>
